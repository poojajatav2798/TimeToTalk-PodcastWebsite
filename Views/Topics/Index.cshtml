@model IEnumerable<Podcast.Web.Models.TopicViewModel>
@{
    ViewData["Title"] = "Topics";
}

<!-- PAGE HEADER -->
<header class="site-header d-flex align-items-center">
    <div class="container">
        <h2>Topics</h2>
        <p class="text-white">Explore podcasts by category and topic</p>
    </div>
</header>

<section class="section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-12 mb-4">
                <div class="section-title-wrap">
                    <h4 class="section-title">All Categories</h4>
                </div>
            </div>

            @foreach (var topic in Model)
            {
                <div class="col-lg-3 col-md-6 col-12 mb-4">
                    <div class="custom-block custom-block-overlay">
                        <a href="/episodes?topic=@topic.Slug" class="custom-block-image-wrap">
                            <img src="@topic.ImageUrl" class="custom-block-image img-fluid" alt="@topic.Title" />
                        </a>

                        <div class="custom-block-info custom-block-overlay-info">
                            <h5 class="mb-1">
                                <a href="/episodes?topic=@topic.Slug">
                                    @topic.Title
                                </a>
                            </h5>
                            <p class="badge mb-0">@topic.EpisodeCount Episodes</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
