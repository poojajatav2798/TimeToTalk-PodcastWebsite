@using Kentico.Web.Mvc
@using Kentico.PageBuilder.Web.Mvc
@inject Kentico.Content.Web.Mvc.IWebPageDataContextRetriever WebPageDataContextRetriever
@model Podcast.Web.Models.EpisodeViewModel
@{
    ViewData["Title"] = "Detail Page";
    var related = ViewBag.RelatedEpisodes as List<Podcast.Web.Models.EpisodeViewModel>;
}

<!-- PAGE HEADER -->
<header class="site-header d-flex flex-column justify-content-center align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-12 text-center">
                <h2 class="mb-0">Detail Page</h2>
            </div>
        </div>
    </div>
</header>

<section class="section-padding">
    <div class="container">
        <!-- Kentico Page Builder Editable Area for Editors -->
        @if (WebPageDataContextRetriever.TryRetrieve(out var pageContext))
        {
            <div class="page-builder-area mb-5">
                @await Html.Kentico().EditableAreaAsync("detail-main-area")
            </div>
        }
        else
        {
            <!-- Standalone Detail View Matching TemplateMo 584 -->
            <div class="episode-detail-widget">
                <!-- Top Category / Badge -->
                <div class="row">
                    <div class="col-lg-12 col-12">
                        <div class="section-title-wrap mb-5">
                            <h4 class="section-title">@(string.IsNullOrEmpty(Model.Topic) ? "Daily talk" : Model.Topic)</h4>
                        </div>
                    </div>
                </div>

                <!-- Main Episode Detail Box -->
                <div class="row mb-5">
                    <div class="col-lg-3 col-md-4 col-12 mb-4 mb-md-0">
                        <div class="custom-block-icon-wrap shadow-sm rounded-4 overflow-hidden">
                            <div class="custom-block-image-wrap custom-block-image-detail-page">
                                <img src="@(string.IsNullOrEmpty(Model.ThumbnailUrl) ? "/images/podcast/27376480_7326766.jpg" : Model.ThumbnailUrl)" class="custom-block-image img-fluid w-100" style="object-fit: cover; min-height: 220px;" alt="@Model.Title">
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-9 col-md-8 col-12">
                        <div class="custom-block-info">
                            <div class="custom-block-top d-flex align-items-center mb-2">
                                <small class="me-4 text-primary fw-bold">
                                    <a href="@Model.AudioUrl" class="text-decoration-none">
                                        <i class="bi-play-fill fs-5 align-middle text-primary"></i> play now
                                    </a>
                                </small>
                                <small class="me-4 text-muted">
                                    <i class="bi-circle-fill text-success me-1" style="font-size: 8px;"></i>
                                    @Model.DurationMinutes Minutes
                                </small>
                                <small class="ms-auto text-muted">
                                    Episode <span class="badge bg-primary text-white ms-1 px-2 py-1">@Model.EpisodeNumber</span>
                                </small>
                            </div>

                            <h2 class="mb-3 fw-bold">@Model.Title</h2>

                            <p class="text-muted mb-3">@Model.ShortDescription</p>
                            <p class="text-muted mb-3">@Model.Description</p>
                            <p class="text-muted mb-4">Pod Talk HTML CSS Template is made by Bootstrap v5.2.2 framework. You are allowed to modify and use this template for your business websites.</p>

                            <!-- Host Profile Detail Box -->
                            <div class="profile-block profile-detail-block d-flex flex-wrap justify-content-between align-items-center mt-4 p-3 bg-white border rounded-pill shadow-sm">
                                <div class="d-flex align-items-center">
                                    <img src="@Model.HostImageUrl" class="profile-block-image rounded-circle me-3" style="width: 48px; height: 48px; object-fit: cover;" alt="@Model.HostName">
                                    <p class="mb-0">
                                        <span class="fw-bold me-1">@Model.HostName</span>
                                        @if (Model.HostIsVerified)
                                        {
                                            <img src="/images/verified.png" class="verified-image img-fluid me-2" style="width: 16px; height: 16px;" alt="Verified">
                                        }
                                        <span class="text-muted small d-block">@Model.HostTitle</span>
                                    </p>
                                </div>

                                <div class="social-share ms-auto mt-2 mt-sm-0">
                                    <ul class="social-icon d-flex list-unstyled mb-0 gap-2">
                                        <li class="social-icon-item">
                                            <a href="https://instagram.com" class="social-icon-link bi-instagram" target="_blank" rel="noopener"></a>
                                        </li>
                                        <li class="social-icon-item">
                                            <a href="https://twitter.com" class="social-icon-link bi-twitter" target="_blank" rel="noopener"></a>
                                        </li>
                                        <li class="social-icon-item">
                                            <a href="https://whatsapp.com" class="social-icon-link bi-whatsapp" target="_blank" rel="noopener"></a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Related Episodes Section -->
                @if (related != null && related.Any())
                {
                    <div class="row">
                        <div class="col-lg-12 col-12">
                            <div class="section-title-wrap my-5">
                                <h4 class="section-title">Related episodes</h4>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        @foreach (var item in related)
                        {
                            <div class="col-lg-4 col-md-6 col-12 mb-4 mb-lg-0">
                                <div class="custom-block custom-block-full">
                                    <div class="custom-block-image-wrap position-relative">
                                        <a href="/episodes/@item.Slug">
                                            <img src="@item.ThumbnailUrl" class="custom-block-image img-fluid w-100" style="height: 200px; object-fit: cover;" alt="@item.Title">
                                        </a>

                                        <div class="d-flex flex-column position-absolute top-0 end-0 m-3 gap-2">
                                            <a href="#" class="badge bg-dark bg-opacity-75 text-white p-2 rounded-circle"><i class="bi-heart"></i></a>
                                            <a href="#" class="badge bg-dark bg-opacity-75 text-white p-2 rounded-circle"><i class="bi-bookmark"></i></a>
                                        </div>
                                    </div>

                                    <div class="custom-block-info">
                                        <h5 class="mb-2">
                                            <a href="/episodes/@item.Slug">@item.Title</a>
                                        </h5>

                                        <div class="profile-block d-flex align-items-center mb-2">
                                            <img src="@item.HostImageUrl" class="profile-block-image rounded-circle me-2" style="width: 36px; height: 36px; object-fit: cover;" alt="@item.HostName">
                                            <p class="mb-0">
                                                <span class="fw-bold">@item.HostName</span>
                                                @if (item.HostIsVerified)
                                                {
                                                    <img src="/images/verified.png" class="verified-image img-fluid" style="width: 14px; height: 14px;" alt="Verified">
                                                }
                                                <strong class="d-block text-muted small">@item.HostTitle</strong>
                                            </p>
                                        </div>

                                        <p class="mb-0 text-muted small">@item.ShortDescription</p>

                                        <div class="custom-block-bottom d-flex justify-content-between mt-3 pt-2 border-top">
                                            <span class="bi-headphones text-muted small"> <span class="text-dark fw-bold">@item.ListensCount</span></span>
                                            <span class="bi-heart text-muted small"> <span class="text-dark fw-bold">@item.LikesCount</span></span>
                                            <span class="bi-chat text-muted small"> <span class="text-dark fw-bold">@item.DownloadsCount</span></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>
