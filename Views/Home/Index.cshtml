@using Kentico.Web.Mvc
@using Kentico.PageBuilder.Web.Mvc
@using Podcast.Web.Components.Sections.SingleColumn
@inject Kentico.Content.Web.Mvc.IWebPageDataContextRetriever WebPageDataContextRetriever
@inject Kentico.PageBuilder.Web.Mvc.IPageBuilderDataContextRetriever PageBuilderDataContextRetriever

@{
    ViewData["Title"] = "Home";

    bool isPageBuilderEditMode = false;
    try 
    {
        var pbContext = PageBuilderDataContextRetriever.Retrieve();
        isPageBuilderEditMode = pbContext.EditMode;
    }
    catch {}

    var homePage = ViewBag.HomePage as TimeToTalk.HomePage;
    var embedUrl = ViewBag.YouTubeEmbedUrl as string ?? "https://www.youtube.com/embed/MGNgbNGOzh8";

    string welcomeText = !string.IsNullOrWhiteSpace(homePage?.HeroWelcomeText) ? homePage.HeroWelcomeText : "Welcome to the club";
    string mainHeading = !string.IsNullOrWhiteSpace(homePage?.HeroMainHeading) ? homePage.HeroMainHeading : "Tiya is";
    string animatedTextRaw = !string.IsNullOrWhiteSpace(homePage?.HeroAnimatedText) ? homePage.HeroAnimatedText : "Modern, Creative, Lifestyle";
    var animatedWords = animatedTextRaw.Split(new[] { ',', '|' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    if (animatedWords.Length == 0)
    {
        animatedWords = new[] { "Modern", "Creative", "Lifestyle" };
    }

    string primaryBtnText = !string.IsNullOrWhiteSpace(homePage?.PrimaryButtonText) ? homePage.PrimaryButtonText : "Our Story";
    string primaryBtnUrl = !string.IsNullOrWhiteSpace(homePage?.PrimaryButtonUrl) ? homePage.PrimaryButtonUrl : "#section_2";
    string secondaryBtnText = !string.IsNullOrWhiteSpace(homePage?.SecondaryButtonText) ? homePage.SecondaryButtonText : "Become a member";
    string secondaryBtnUrl = !string.IsNullOrWhiteSpace(homePage?.SecondaryButtonUrl) ? homePage.SecondaryButtonUrl : "#section_3";
    string bgImage = !string.IsNullOrWhiteSpace(homePage?.HeroBackgroundImage) ? homePage.HeroBackgroundImage : "";

    var hosts = ViewBag.Hosts as List<Podcast.Web.Models.HostViewModel>;
    var episodes = ViewBag.LatestEpisodes as List<Podcast.Web.Models.EpisodeViewModel>;
    var trending = ViewBag.TrendingEpisodes as List<Podcast.Web.Models.EpisodeViewModel>;
    var topics = ViewBag.Topics as List<Podcast.Web.Models.TopicViewModel>;
}

<!-- Dynamic Homepage Hero Section (CMS-driven from TimeToTalk.HomePage, not a Page Builder widget) -->
<section class="hero-section d-flex justify-content-center align-items-center" id="section_1" style="@(!string.IsNullOrWhiteSpace(bgImage) ? $"background-image: url('{bgImage}');" : "")">
    <div class="section-overlay"></div>

    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="#3D405B" fill-opacity="1" d="M0,224L34.3,192C68.6,160,137,96,206,90.7C274.3,85,343,139,411,144C480,149,549,107,617,122.7C685.7,139,754,213,823,240C891.4,267,960,245,1029,224C1097.1,203,1166,181,1234,160C1302.9,139,1371,117,1406,106.7L1440,96L1440,0L1405.7,0C1371.4,0,1303,0,1234,0C1165.7,0,1097,0,1029,0C960,0,891,0,823,0C754.3,0,686,0,617,0C548.6,0,480,0,411,0C342.9,0,274,0,206,0C137.1,0,69,0,34,0L0,0Z"></path></svg>

    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-12 mb-5 mb-lg-0">
                <h2 class="text-white">@welcomeText</h2>

                <h1 class="cd-headline rotate-1 text-white mb-4 pb-2">
                    <span>@mainHeading</span>
                    <span class="cd-words-wrapper">
                        @for (int i = 0; i < animatedWords.Length; i++)
                        {
                            <b class="@(i == 0 ? "is-visible" : "")">@animatedWords[i]</b>
                        }
                    </span>
                </h1>

                <div class="custom-btn-group">
                    <a href="@primaryBtnUrl" class="btn custom-btn smoothscroll me-3">@primaryBtnText</a>
                    <a href="@secondaryBtnUrl" class="link smoothscroll">@secondaryBtnText</a>
                </div>
            </div>

            <div class="col-lg-6 col-12">
                <div class="ratio ratio-16x9">
                    <iframe width="560" height="315" src="@embedUrl" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>

    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="#ffffff" fill-opacity="1" d="M0,224L34.3,192C68.6,160,137,96,206,90.7C274.3,85,343,139,411,144C480,149,549,107,617,122.7C685.7,139,754,213,823,240C891.4,267,960,245,1029,224C1097.1,203,1166,181,1234,160C1302.9,139,1371,117,1406,106.7L1440,96L1440,320L1405.7,320C1371.4,320,1303,320,1234,320C1165.7,320,1097,320,1029,320C960,320,891,320,823,320C754.3,320,686,320,617,320C548.6,320,480,320,411,320C342.9,320,274,320,206,320C137.1,320,69,320,34,320L0,320Z"></path></svg>
</section>

@* 
   ========================================================================
   PAGE BUILDER EDITABLE AREA
   Follows the Xperience Page Builder pattern:
   1. The Home Page contains an editable area.
   2. The editable area allows editors to add different sections.
   3. Each section contains at least one widget zone.
   4. Editors can add registered widgets inside those zones.
   ========================================================================
*@
@if (WebPageDataContextRetriever.TryRetrieve(out var pageContext))
{
    <div class="podtalk-page-builder-canvas">
        @await Html.Kentico().EditableAreaAsync("main", new EditableAreaOptions 
        { 
            DefaultSectionIdentifier = SingleColumnSectionProperties.IDENTIFIER 
        })
    </div>
}

@* 
   When in Kentico Admin Page Builder Edit Mode (iframe), hide static fallback 
   so editors get a clean, modular visual canvas to add sections and widgets!
*@
@if (!isPageBuilderEditMode)
{
    <!-- Default Content Area (Rendered dynamically from Repositories / CMS Content Hub) -->
    <!-- 2. Latest Episodes Section -->
    <section class="latest-podcast-section section-padding pb-0" id="section_2">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-12 col-12">
                    <div class="section-title-wrap mb-5">
                        <h4 class="section-title">Lastest episodes</h4>
                    </div>
                </div>

                @if (episodes != null && episodes.Any())
                {
                    @foreach (var episode in episodes)
                    {
                        <div class="col-lg-6 col-12 mb-4">
                            <div class="custom-block d-flex">
                                <div>
                                    <div class="custom-block-icon-wrap">
                                        <div class="section-overlay"></div>
                                        <a asp-controller="Detail" asp-action="Index" asp-route-slug="@episode.Slug" class="custom-block-image-wrap">
                                            <img src="@episode.ThumbnailUrl" class="custom-block-image img-fluid" alt="@episode.Title">
                                            <span class="custom-block-icon">
                                                <i class="bi-play-fill"></i>
                                            </span>
                                        </a>
                                    </div>

                                    <div class="mt-2">
                                        <a asp-controller="Detail" asp-action="Index" asp-route-slug="@episode.Slug" class="btn custom-btn">
                                            Subscribe
                                        </a>
                                    </div>
                                </div>

                                <div class="custom-block-info">
                                    <div class="custom-block-top d-flex mb-1">
                                        <small class="me-4">
                                            <i class="bi-clock-fill custom-icon"></i>
                                            @episode.DurationMinutes Minutes
                                        </small>
                                        <small>Episode <span class="badge">@episode.EpisodeNumber</span></small>
                                    </div>

                                    <h5 class="mb-2">
                                        <a asp-controller="Detail" asp-action="Index" asp-route-slug="@episode.Slug">
                                            @episode.Title
                                        </a>
                                    </h5>

                                    <div class="profile-block d-flex">
                                        <img src="@episode.HostImageUrl" class="profile-block-image img-fluid" alt="@episode.HostName">
                                        <p>
                                            @episode.HostName
                                            @if (episode.HostIsVerified)
                                            {
                                                <img src="/images/verified.png" class="verified-image img-fluid" alt="Verified">
                                            }
                                            <strong>@episode.HostTitle</strong>
                                        </p>
                                    </div>

                                    <p class="mb-0">@episode.ShortDescription</p>

                                    <div class="custom-block-bottom d-flex justify-content-between mt-3">
                                        <span class="bi-headphones me-1"><span>@episode.ListensCount</span></span>
                                        <span class="bi-heart me-1"><span>@episode.LikesCount</span></span>
                                        <span class="bi-chat me-1"><span>@episode.CommentsCount</span></span>
                                        <span class="bi-download"><span>@episode.DownloadsCount</span></span>
                                    </div>
                                </div>

                                <div class="d-flex flex-column ms-auto">
                                    <a href="#" class="badge ms-auto"><i class="bi-heart"></i></a>
                                    <a href="#" class="badge ms-auto"><i class="bi-bookmark"></i></a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>

    <!-- 3. Topics Section -->
    <section class="topics-section section-padding pb-0" id="section_3">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 col-12">
                    <div class="section-title-wrap mb-5">
                        <h4 class="section-title">Topics</h4>
                    </div>
                </div>
                @if (topics != null && topics.Any())
                {
                    @foreach (var topic in topics)
                    {
                        <div class="col-lg-3 col-md-6 col-12 mb-4 mb-lg-0">
                            <div class="custom-block custom-block-overlay">
                                <a asp-controller="Listing" asp-action="Index" asp-route-topic="@topic.Slug" class="custom-block-image-wrap">
                                    <img src="@topic.ImageUrl" class="custom-block-image img-fluid" alt="@topic.Title">
                                </a>

                                <div class="custom-block-info custom-block-overlay-info">
                                    <h5 class="mb-1">
                                        <a asp-controller="Listing" asp-action="Index" asp-route-topic="@topic.Slug">
                                            @topic.Title
                                        </a>
                                    </h5>
                                    <p class="badge mb-0">@topic.EpisodeCount Episodes</p>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>

    <!-- 4. Trending Section -->
    <section class="trending-podcast-section section-padding">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 col-12">
                    <div class="section-title-wrap mb-5">
                        <h4 class="section-title">Trending episodes</h4>
                    </div>
                </div>
                @if (trending != null && trending.Any())
                {
                    @foreach (var episode in trending)
                    {
                        <div class="col-lg-4 col-12 mb-4 mb-lg-0">
                            <div class="custom-block custom-block-full">
                                <div class="custom-block-image-wrap">
                                    <a asp-controller="Detail" asp-action="Index" asp-route-slug="@episode.Slug">
                                        <img src="@episode.ThumbnailUrl" class="custom-block-image img-fluid" alt="@episode.Title">
                                    </a>
                                </div>

                                <div class="custom-block-info">
                                    <h5 class="mb-2">
                                        <a asp-controller="Detail" asp-action="Index" asp-route-slug="@episode.Slug">
                                            @episode.Title
                                        </a>
                                    </h5>

                                    <div class="profile-block d-flex">
                                        <img src="@episode.HostImageUrl" class="profile-block-image img-fluid" alt="@episode.HostName">
                                        <p>
                                            @episode.HostName
                                            @if (episode.HostIsVerified)
                                            {
                                                <img src="/images/verified.png" class="verified-image img-fluid" alt="Verified">
                                            }
                                            <strong>@episode.HostTitle</strong>
                                        </p>
                                    </div>

                                    <p class="mb-0">@episode.ShortDescription</p>

                                    <div class="custom-block-bottom d-flex justify-content-between mt-3">
                                        <span class="bi-headphones me-1"><span>@episode.ListensCount</span></span>
                                        <span class="bi-heart me-1"><span>@episode.LikesCount</span></span>
                                        <span class="bi-chat me-1"><span>@episode.CommentsCount</span></span>
                                    </div>
                                </div>

                                <div class="social-share d-flex flex-column ms-auto">
                                    <a href="#" class="badge ms-auto"><i class="bi-heart"></i></a>
                                    <a href="#" class="badge ms-auto"><i class="bi-bookmark"></i></a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
}
