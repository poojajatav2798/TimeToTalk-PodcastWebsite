@using Kentico.Web.Mvc
@using Kentico.PageBuilder.Web.Mvc
@inject Kentico.Content.Web.Mvc.IWebPageDataContextRetriever WebPageDataContextRetriever

@{
    ViewData["Title"] = "About Us";
    var hosts = ViewBag.Hosts as List<Podcast.Web.Models.HostViewModel>;
}

<!-- Kentico Page Builder Editable Area for Editors -->
@if (WebPageDataContextRetriever.TryRetrieve(out var pageContext))
{
    <div class="page-builder-area">
        @await Html.Kentico().EditableAreaAsync("about_main_area")
    </div>
}

<!-- PAGE HEADER -->
<header class="site-header d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-12">
                <h2>About Pod Talk</h2>
                <p class="text-white">Learn more about our mission, vision, and the voices behind Pod Talk</p>
            </div>
        </div>
    </div>
</header>

<!-- STORY / ABOUT SECTION -->
<section class="about-section section-padding">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-12 mb-4 mb-lg-0">
                <div class="about-image-wrap">
                    <img src="/images/topics/physician-consulting-his-patient-clinic.jpg" class="img-fluid rounded-4 shadow" alt="About Pod Talk" />
                </div>
            </div>

            <div class="col-lg-6 col-12">
                <div class="section-title-wrap mb-4">
                    <h3 class="section-title">Every Voice Matters</h3>
                </div>
                <p class="lead text-muted">Pod Talk is a modern podcast platform dedicated to bringing creators and listeners together. We share stories, interviews, and deep conversations on culture, technology, business, and life.</p>
                <p>From tech founders and medical experts to indie artists and educators, Pod Talk delivers authentic audio experiences right to your headphones wherever you are.</p>
                <div class="mt-4">
                    <a href="/episodes" class="btn custom-btn me-3">Browse Episodes</a>
                    <a href="/contact" class="btn custom-border-btn">Contact Us</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- HOSTS / TEAM SECTION -->
@if (hosts != null && hosts.Any())
{
    <section class="topics-section section-padding bg-light">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 col-12 text-center mb-5">
                    <h3 class="section-title">Meet Our Creators & Hosts</h3>
                    <p class="text-muted">The talented creators bringing you insightful conversations every week</p>
                </div>

                @foreach (var host in hosts)
                {
                    <div class="col-lg-4 col-md-6 col-12 mb-4">
                        <div class="custom-block custom-block-full">
                            <div class="custom-block-image-wrap">
                                <a href="#">
                                    <img src="@host.ImageUrl" class="custom-block-image img-fluid" alt="@host.Name" />
                                </a>
                            </div>

                            <div class="custom-block-info">
                                <h5 class="mb-2">@host.Name</h5>
                                <p class="badge bg-primary mb-2">@host.Category</p>
                                <p class="mb-0">@host.Bio</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
