@using Kentico.Content.Web.Mvc.PageBuilder
@using Kentico.PageBuilder.Web.Mvc
@using Kentico.Web.Mvc
@inject Podcast.Web.Services.ITiyaContentRepository ContentRepo
@addTagHelper *, Kentico.Content.Web.Mvc

@model TemplateViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Tiya Golf Club - Home";

    var homePage = await ContentRepo.GetHomePageContentAsync();

    string welcomeText = !string.IsNullOrWhiteSpace(homePage?.HeroWelcomeText) ? homePage.HeroWelcomeText : "Welcome to the club";
    string mainHeading = !string.IsNullOrWhiteSpace(homePage?.HeroMainHeading) ? homePage.HeroMainHeading : "Tiya is";
    string animatedTextRaw = !string.IsNullOrWhiteSpace(homePage?.HeroAnimatedText) ? homePage.HeroAnimatedText : "Modern, Creative, Lifestyle";
    var animatedWords = animatedTextRaw.Split(new[] { ',', '|' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    if (animatedWords.Length == 0)
    {
        animatedWords = new[] { "Modern", "Creative", "Lifestyle" };
    }

    string primaryBtnText = !string.IsNullOrWhiteSpace(homePage?.PrimaryButtonText) ? homePage.PrimaryButtonText : "Our Story";
    string primaryBtnUrl = !string.IsNullOrWhiteSpace(homePage?.PrimaryButtonUrl) ? homePage.PrimaryButtonUrl : "#section_2";
    string secondaryBtnText = !string.IsNullOrWhiteSpace(homePage?.SecondaryButtonText) ? homePage.SecondaryButtonText : "Become a member";
    string secondaryBtnUrl = !string.IsNullOrWhiteSpace(homePage?.SecondaryButtonUrl) ? homePage.SecondaryButtonUrl : "#section_3";
    string bgImage = !string.IsNullOrWhiteSpace(homePage?.HeroBackgroundImage) ? homePage.HeroBackgroundImage : "";

    string embedUrl = "https://www.youtube.com/embed/MGNgbNGOzh8";
    if (!string.IsNullOrWhiteSpace(homePage?.HeroVideoUrl))
    {
        var rawUrl = homePage.HeroVideoUrl.Trim();
        if (rawUrl.Contains("youtube.com/watch?v="))
        {
            var videoId = rawUrl.Split("v=")[1].Split('&')[0];
            embedUrl = $"https://www.youtube.com/embed/{videoId}";
        }
        else if (rawUrl.Contains("youtu.be/"))
        {
            var videoId = rawUrl.Split("youtu.be/")[1].Split('?')[0];
            embedUrl = $"https://www.youtube.com/embed/{videoId}";
        }
        else if (rawUrl.Contains("youtube.com/embed/"))
        {
            embedUrl = rawUrl;
        }
    }
}

<!-- Dynamic Homepage Hero Section (CMS-driven from TimeToTalk.HomePage, not a Page Builder widget) -->
<section class="hero-section d-flex justify-content-center align-items-center" id="section_1" style="@(!string.IsNullOrWhiteSpace(bgImage) ? $"background-image: url('{bgImage}');" : "")">
    <div class="section-overlay"></div>

    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="#3D405B" fill-opacity="1" d="M0,224L34.3,192C68.6,160,137,96,206,90.7C274.3,85,343,139,411,144C480,149,549,107,617,122.7C685.7,139,754,213,823,240C891.4,267,960,245,1029,224C1097.1,203,1166,181,1234,160C1302.9,139,1371,117,1406,106.7L1440,96L1440,0L1405.7,0C1371.4,0,1303,0,1234,0C1165.7,0,1097,0,1029,0C960,0,891,0,823,0C754.3,0,686,0,617,0C548.6,0,480,0,411,0C342.9,0,274,0,206,0C137.1,0,69,0,34,0L0,0Z"></path></svg>

    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-12 mb-5 mb-lg-0">
                <h2 class="text-white">@welcomeText</h2>

                <h1 class="cd-headline rotate-1 text-white mb-4 pb-2">
                    <span>@mainHeading</span>
                    <span class="cd-words-wrapper">
                        @for (int i = 0; i < animatedWords.Length; i++)
                        {
                            <b class="@(i == 0 ? "is-visible" : "")">@animatedWords[i]</b>
                        }
                    </span>
                </h1>

                <div class="custom-btn-group">
                    <a href="@primaryBtnUrl" class="btn custom-btn smoothscroll me-3">@primaryBtnText</a>
                    <a href="@secondaryBtnUrl" class="link smoothscroll">@secondaryBtnText</a>
                </div>
            </div>

            <div class="col-lg-6 col-12">
                <div class="ratio ratio-16x9">
                    <iframe width="560" height="315" src="@embedUrl" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>

    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="#ffffff" fill-opacity="1" d="M0,224L34.3,192C68.6,160,137,96,206,90.7C274.3,85,343,139,411,144C480,149,549,107,617,122.7C685.7,139,754,213,823,240C891.4,267,960,245,1029,224C1097.1,203,1166,181,1234,160C1302.9,139,1371,117,1406,106.7L1440,96L1440,320L1405.7,320C1371.4,320,1303,320,1234,320C1165.7,320,1097,320,1029,320C960,320,891,320,823,320C754.3,320,686,320,617,320C548.6,320,480,320,411,320C342.9,320,274,320,206,320C137.1,320,69,320,34,320L0,320Z"></path></svg>
</section>

