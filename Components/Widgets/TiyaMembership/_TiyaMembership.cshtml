@model Podcast.Web.Components.Widgets.TiyaMembership.TiyaMembershipViewModel

@{
    var t1Price = Model.Tiers != null && Model.Tiers.Count > 0 ? Model.Tiers[0].Price : Model.Properties.T1Price;
    var t2Price = Model.Tiers != null && Model.Tiers.Count > 1 ? Model.Tiers[1].Price : Model.Properties.T2Price;
    var t3Price = Model.Tiers != null && Model.Tiers.Count > 2 ? Model.Tiers[2].Price : Model.Properties.T3Price;
    var featureList = Model.Features ?? new List<Podcast.Web.Models.MembershipFeatureRowModel>();
}

<section class="membership-section section-padding" id="section_3">
    <div class="container">
        <div class="row">

            <div class="col-lg-12 col-12 text-center mx-auto mb-lg-5 mb-4">
                <h2>@Model.Properties.SectionTitle</h2>
            </div>

            <div class="col-lg-6 col-12 mb-3 mb-lg-0">
                <h4 class="mb-4 pb-lg-2">@Model.Properties.TableHeading</h4>

                <div class="table-responsive">
                    <table class="table text-center">
                        <thead>
                            <tr>
                                <th style="width: 34%;">@(Model.Properties.CycleHeading ?? "Yearly Access")</th>
                                @if (Model.Tiers != null && Model.Tiers.Any())
                                {
                                    foreach (var tier in Model.Tiers)
                                    {
                                        <th scope="col">
                                            <div>@(string.IsNullOrWhiteSpace(tier.Price) ? tier.Name : tier.Price)</div>
                                            <small class="text-muted d-block" style="font-size:0.75rem; font-weight:normal;">@tier.Name</small>
                                        </th>
                                    }
                                }
                                else
                                {
                                    <th style="width: 22%;">@t1Price</th>
                                    <th style="width: 22%;">@t2Price</th>
                                    <th style="width: 22%;">@t3Price</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @if (featureList.Any())
                            {
                                foreach (var feat in featureList)
                                {
                                    <tr>
                                        <th scope="row" class="text-start">@feat.FeatureName</th>
                                        @for (int t = 0; t < (Model.Tiers?.Count ?? 0); t++)
                                        {
                                            var tier = Model.Tiers![t];
                                            var isAvail = feat.IsAvailableForTier(t, tier);
                                            <td>
                                                @if (isAvail)
                                                {
                                                    <i class="bi-check-circle-fill text-success"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi-x-circle-fill text-danger"></i>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-lg-5 col-12 mx-auto">
                <h4 class="mb-4 pb-lg-2">@Model.Properties.FormSubheading</h4>
                <form action="#" method="post" class="custom-form membership-form shadow-lg" role="form" onsubmit="event.preventDefault(); alert('Thank you! Your membership request has been submitted.'); this.reset();">
                    <h4 class="text-white mb-4">@Model.Properties.FormTitle</h4>

                    @if (Model.FormFields != null && Model.FormFields.Any())
                    {
                        foreach (var field in Model.FormFields)
                        {
                            var fieldType = (field.Type ?? "text").ToLowerInvariant();
                            var fieldId = "member-" + field.Name;

                            if (fieldType == "textarea")
                            {
                                <div class="form-floating mb-3">
                                    <textarea class="form-control" id="@fieldId" name="@field.Name" placeholder="@field.Placeholder" style="height: 100px;" @(field.IsRequired ? "required" : "")></textarea>
                                    <label for="@fieldId">@field.Label</label>
                                </div>
                            }
                            else if (fieldType == "dropdown" || fieldType == "select")
                            {
                                <div class="form-floating mb-3">
                                    <select class="form-select" id="@fieldId" name="@field.Name" @(field.IsRequired ? "required" : "")>
                                        <option value="">-- Select @field.Label --</option>
                                        @foreach (var opt in field.Options)
                                        {
                                            <option value="@opt">@opt</option>
                                        }
                                    </select>
                                    <label for="@fieldId">@field.Label</label>
                                </div>
                            }
                            else
                            {
                                <div class="form-floating mb-3">
                                    <input type="@(fieldType == "email" ? "email" : fieldType == "phone" ? "tel" : "text")" class="form-control" id="@fieldId" name="@field.Name" placeholder="@field.Placeholder" @(field.IsRequired ? "required" : "")>
                                    <label for="@fieldId">@field.Label</label>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <!-- Fallback default fields if no dynamic fields configured -->
                        <div class="form-floating mb-3">
                            <input type="text" name="member-name" id="member-name" class="form-control" placeholder="Full Name" required>
                            <label for="member-name">Full Name</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="email" name="member-email" id="member-email" pattern="[^ @@]*@@[^ @@]*" class="form-control" placeholder="Email address" required>
                            <label for="member-email">Email address</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="tel" name="member-phone" id="member-phone" class="form-control" placeholder="Phone Number">
                            <label for="member-phone">Phone Number</label>
                        </div>

                        <div class="form-floating mb-3">
                            <textarea class="form-control" id="member-message" name="member-message" placeholder="Describe your membership query" style="height: 100px;"></textarea>
                            <label for="member-message">Additional comments</label>
                        </div>
                    }

                    <button type="submit" class="form-control mt-4">Submit</button>
                </form>
            </div>

        </div>
    </div>
</section>
