@model Podcast.Web.Components.Widgets.TiyaAbout.TiyaAboutViewModel

<section class="about-section section-padding" id="section_2">
    <div class="container">
        <div class="row">

            <div class="col-lg-12 col-12 text-center">
                <h2 class="mb-lg-5 mb-4">@Model.Properties.SectionTitle</h2>
            </div>

            <div class="col-lg-5 col-12 me-auto mb-4 mb-lg-0">
                <h3 class="mb-3">@Model.Properties.HistoryHeading</h3>

                @if (!string.IsNullOrEmpty(Model.Properties.HistoryParagraph1))
                {
                    <p>@Model.Properties.HistoryParagraph1</p>
                }

                @if (!string.IsNullOrEmpty(Model.Properties.HistoryParagraph2))
                {
                    <p>@Model.Properties.HistoryParagraph2</p>
                }
            </div>

            @if (Model.TeamMembers != null && Model.TeamMembers.Any())
            {
                foreach (var member in Model.TeamMembers)
                {
                    <div class="col-lg-3 col-md-6 col-12 mb-4 mb-lg-0">
                        <div class="member-block">
                            <div class="member-block-image-wrap">
                                <img src="@member.ImageUrl" class="member-block-image img-fluid" alt="@member.Name">

                                <ul class="social-icon">
                                    @if (member.SocialLinks != null && member.SocialLinks.Any())
                                    {
                                        foreach (var social in member.SocialLinks)
                                        {
                                            if (!string.IsNullOrWhiteSpace(social.Url))
                                            {
                                                <li class="social-icon-item">
                                                    <a href="@social.Url" class="social-icon-link @social.IconClass" target="_blank" rel="noopener" title="@social.Platform"></a>
                                                </li>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        @if (!string.IsNullOrEmpty(member.TwitterUrl))
                                        {
                                            <li class="social-icon-item">
                                                <a href="@member.TwitterUrl" class="social-icon-link bi-twitter" target="_blank" rel="noopener" title="Twitter"></a>
                                            </li>
                                        }

                                        @if (!string.IsNullOrEmpty(member.WhatsAppUrl))
                                        {
                                            <li class="social-icon-item">
                                                <a href="@member.WhatsAppUrl" class="social-icon-link bi-whatsapp" target="_blank" rel="noopener" title="WhatsApp"></a>
                                            </li>
                                        }

                                        @if (!string.IsNullOrEmpty(member.LinkedInUrl))
                                        {
                                            <li class="social-icon-item">
                                                <a href="@member.LinkedInUrl" class="social-icon-link bi-linkedin" target="_blank" rel="noopener" title="LinkedIn"></a>
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>

                            <div class="member-block-info d-flex align-items-center">
                                <h4>@member.Name</h4>
                                <p class="ms-auto">@member.Role</p>
                            </div>
                        </div>
                    </div>
                }
            }

        </div>
    </div>
</section>
