@model Podcast.Web.Components.Widgets.TiyaAbout.TiyaAboutViewModel

<section class="about-section section-padding" id="section_2">
    <div class="container">
        <div class="row">

            <div class="col-lg-12 col-12 text-center">
                <h2 class="mb-lg-5 mb-4">@Model.Properties.SectionTitle</h2>
            </div>

            <div class="col-lg-5 col-12 me-auto mb-4 mb-lg-0">
                <h3 class="mb-3">@Model.Properties.HistoryHeading</h3>

                @if (!string.IsNullOrEmpty(Model.Properties.HistoryParagraph1))
                {
                    <p>@Model.Properties.HistoryParagraph1</p>
                }

                @if (!string.IsNullOrEmpty(Model.Properties.HistoryParagraph2))
                {
                    <p>@Model.Properties.HistoryParagraph2</p>
                }
            </div>

            <div class="col-lg-3 col-md-6 col-12 mb-4 mb-lg-0 mb-md-0">
                <div class="member-block">
                    <div class="member-block-image-wrap">
                        <img src="@Model.Properties.Member1ImageUrl" class="member-block-image img-fluid" alt="@Model.Properties.Member1Name">

                        <ul class="social-icon">
                            @if (!string.IsNullOrEmpty(Model.Properties.Member1TwitterUrl))
                            {
                                <li class="social-icon-item">
                                    <a href="@Model.Properties.Member1TwitterUrl" class="social-icon-link bi-twitter" target="_blank" rel="noopener"></a>
                                </li>
                            }

                            @if (!string.IsNullOrEmpty(Model.Properties.Member1WhatsAppUrl))
                            {
                                <li class="social-icon-item">
                                    <a href="@Model.Properties.Member1WhatsAppUrl" class="social-icon-link bi-whatsapp" target="_blank" rel="noopener"></a>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="member-block-info d-flex align-items-center">
                        <h4>@Model.Properties.Member1Name</h4>
                        <p class="ms-auto">@Model.Properties.Member1Role</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-12">
                <div class="member-block">
                    <div class="member-block-image-wrap">
                        <img src="@Model.Properties.Member2ImageUrl" class="member-block-image img-fluid" alt="@Model.Properties.Member2Name">

                        <ul class="social-icon">
                            @if (!string.IsNullOrEmpty(Model.Properties.Member2LinkedInUrl))
                            {
                                <li class="social-icon-item">
                                    <a href="@Model.Properties.Member2LinkedInUrl" class="social-icon-link bi-linkedin" target="_blank" rel="noopener"></a>
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(Model.Properties.Member2TwitterUrl))
                            {
                                <li class="social-icon-item">
                                    <a href="@Model.Properties.Member2TwitterUrl" class="social-icon-link bi-twitter" target="_blank" rel="noopener"></a>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="member-block-info d-flex align-items-center">
                        <h4>@Model.Properties.Member2Name</h4>
                        <p class="ms-auto">@Model.Properties.Member2Role</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
