@model Podcast.Web.Components.Widgets.TiyaEvents.TiyaEventsViewModel

@{
    var widgetUid = "events_" + Guid.NewGuid().ToString("N").Substring(0, 8);
    var pageSize = Model.Properties.EventsPerPage > 0 ? Model.Properties.EventsPerPage : 2;
    var eventList = Model.Events ?? new List<Podcast.Web.Components.Widgets.TiyaEvents.EventItemModel>();
}

<section class="events-section section-bg section-padding" id="section_4">
    <div class="container" id="@widgetUid">
        <div class="row">

            <div class="col-lg-12 col-12 mb-4">
                <h2 class="mb-lg-3">@Model.Properties.SectionTitle</h2>
            </div>

            <div class="col-12 events-container">
                @for (int i = 0; i < eventList.Count; i++)
                {
                    var ev = eventList[i];
                    var pageIndex = (i / pageSize) + 1;
                    <div class="row custom-block @(ev.IsAltBackground ? "custom-block-bg" : "") mb-4 event-card-item" data-page="@pageIndex" style="@(pageIndex > 1 ? "display:none;" : "")">
                        <div class="col-lg-2 col-md-4 col-12 order-2 order-md-0 order-lg-0">
                            <div class="custom-block-date-wrap d-flex d-lg-block d-md-block align-items-center mt-3 mt-lg-0 mt-md-0">
                                <h6 class="custom-block-date mb-lg-1 mb-0 me-3 me-lg-0 me-md-0">@ev.Day</h6>
                                <strong class="text-white">@ev.MonthYear</strong>
                            </div>
                        </div>

                        <div class="col-lg-4 col-md-8 col-12 order-1 order-lg-0">
                            <div class="custom-block-image-wrap">
                                <a href="@ev.Url">
                                    <img src="@ev.ImageUrl" class="custom-block-image img-fluid" alt="@ev.Title">
                                    <i class="custom-block-icon bi-link"></i>
                                </a>
                            </div>
                        </div>

                        <div class="col-lg-6 col-12 order-3 order-lg-0">
                            <div class="custom-block-info mt-2 mt-lg-0">
                                <a href="@ev.Url" class="events-title mb-3">@ev.Title</a>

                                <p class="mb-0">@ev.Description</p>

                                <div class="d-flex flex-wrap border-top mt-4 pt-3">
                                    <div class="mb-4 mb-lg-0">
                                        <div class="d-flex flex-wrap align-items-center mb-1">
                                            <span class="custom-block-span">Location:</span>
                                            <p class="mb-0">@ev.Location</p>
                                        </div>

                                        <div class="d-flex flex-wrap align-items-center">
                                            <span class="custom-block-span">Ticket:</span>
                                            <p class="mb-0">@ev.TicketPrice</p>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center ms-lg-auto">
                                        <a href="@ev.Url" class="btn custom-btn">Buy Ticket</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.Properties.EnablePagination && eventList.Any())
            {
                var totalPages = (int)Math.Ceiling((double)eventList.Count / pageSize);
                if (totalPages <= 1) totalPages = 2;
                <div class="col-12 mt-4 d-flex justify-content-center">
                    <ul class="pagination event-pagination" data-target="@widgetUid" data-total-pages="@totalPages">
                        <li class="page-item disabled prev-btn">
                            <a class="page-link" href="javascript:void(0);">Prev</a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == 1 ? "active" : "") page-num" data-page="@p">
                                <a class="page-link" href="javascript:void(0);">@p</a>
                            </li>
                        }
                        <li class="page-item next-btn @(totalPages <= 1 ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);">Next</a>
                        </li>
                    </ul>
                </div>

                <script>
                    (function () {
                        var widgetId = '@widgetUid';
                        var container = document.getElementById(widgetId);
                        if (!container) return;

                        var pagination = container.querySelector('.event-pagination');
                        if (!pagination) return;

                        var totalPages = parseInt(pagination.getAttribute('data-total-pages'), 10) || 1;
                        var currentPage = 1;

                        function showPage(page) {
                            if (page < 1 || page > totalPages) return;
                            currentPage = page;

                            var items = container.querySelectorAll('.event-card-item');
                            var found = false;
                            items.forEach(function (el) {
                                var p = parseInt(el.getAttribute('data-page'), 10);
                                if (p === page) {
                                    el.style.display = '';
                                    found = true;
                                } else {
                                    el.style.display = 'none';
                                }
                            });

                            if (!found && items.length > 0) {
                                items.forEach(function (el, idx) {
                                    el.style.display = idx < 2 ? '' : 'none';
                                });
                            }

                            pagination.querySelectorAll('.page-num').forEach(function (btn) {
                                var p = parseInt(btn.getAttribute('data-page'), 10);
                                if (p === page) btn.classList.add('active');
                                else btn.classList.remove('active');
                            });

                            var prevBtn = pagination.querySelector('.prev-btn');
                            var nextBtn = pagination.querySelector('.next-btn');
                            if (prevBtn) {
                                if (currentPage === 1) prevBtn.classList.add('disabled');
                                else prevBtn.classList.remove('disabled');
                            }
                            if (nextBtn) {
                                if (currentPage === totalPages) nextBtn.classList.add('disabled');
                                else nextBtn.classList.remove('disabled');
                            }
                        }

                        pagination.addEventListener('click', function (e) {
                            var target = e.target.closest('li.page-item');
                            if (!target || target.classList.contains('disabled')) return;

                            if (target.classList.contains('prev-btn')) {
                                showPage(currentPage - 1);
                            } else if (target.classList.contains('next-btn')) {
                                showPage(currentPage + 1);
                            } else if (target.hasAttribute('data-page')) {
                                var page = parseInt(target.getAttribute('data-page'), 10);
                                showPage(page);
                            }
                        });
                    })();
                </script>
            }

        </div>
    </div>
</section>
