@model Podcast.Web.Components.Widgets.TiyaEventListing.TiyaEventListingViewModel

@{
    var widgetUid = "listing_" + Guid.NewGuid().ToString("N").Substring(0, 8);
    var pageSize = Model.Properties.EventsPerPage > 0 ? Model.Properties.EventsPerPage : 4;
    var eventList = Model.Events ?? new List<Podcast.Web.Components.Widgets.TiyaEvents.EventItemModel>();
}

<!-- Hero 50 Section -->
<section class="hero-section hero-50 d-flex justify-content-center align-items-center" id="section_1">
    <div class="section-overlay"></div>

    <svg viewBox="0 0 1962 178" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
        <path fill="#3D405B" d="M 0 114 C 118.5 114 118.5 167 237 167 L 237 167 L 237 0 L 0 0 Z" stroke-width="0"></path>
        <path fill="#3D405B" d="M 236 167 C 373 167 373 128 510 128 L 510 128 L 510 0 L 236 0 Z" stroke-width="0"></path>
        <path fill="#3D405B" d="M 509 128 C 607 128 607 153 705 153 L 705 153 L 705 0 L 509 0 Z" stroke-width="0"></path>
        <path fill="#3D405B" d="M 704 153 C 812 153 812 113 920 113 L 920 113 L 920 0 L 704 0 Z" stroke-width="0"></path>
        <path fill="#3D405B" d="M 919 113 C 1048.5 113 1048.5 148 1178 148 L 1178 148 L 1178 0 L 919 0 Z" stroke-width="0"></path>
        <path fill="#3D405B" d="M 1177 148 C 1359.5 148 1359.5 129 1542 129 L 1542 129 L 1542 0 L 1177 0 Z" stroke-width="0"></path>
        <path fill="#3D405B" d="M 1541 129 C 1751.5 129 1751.5 138 1962 138 L 1962 138 L 1962 0 L 1541 0 Z" stroke-width="0"></path>
    </svg>

    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-12">
                <h1 class="text-white mb-4 pb-2">@Model.Properties.HeroTitle</h1>
                <a href="#section_2" class="btn custom-btn smoothscroll me-3">Explore Events</a>
            </div>
        </div>
    </div>

    <svg viewBox="0 0 1962 178" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
        <path fill="#ffffff" d="M 0 114 C 118.5 114 118.5 167 237 167 L 237 167 L 237 0 L 0 0 Z" stroke-width="0"></path>
        <path fill="#ffffff" d="M 236 167 C 373 167 373 128 510 128 L 510 128 L 510 0 L 236 0 Z" stroke-width="0"></path>
        <path fill="#ffffff" d="M 509 128 C 607 128 607 153 705 153 L 705 153 L 705 0 L 509 0 Z" stroke-width="0"></path>
        <path fill="#ffffff" d="M 704 153 C 812 153 812 113 920 113 L 920 113 L 920 0 L 704 0 Z" stroke-width="0"></path>
        <path fill="#ffffff" d="M 919 113 C 1048.5 113 1048.5 148 1178 148 L 1178 148 L 1178 0 L 919 0 Z" stroke-width="0"></path>
        <path fill="#ffffff" d="M 1177 148 C 1359.5 148 1359.5 129 1542 129 L 1542 129 L 1542 0 L 1177 0 Z" stroke-width="0"></path>
        <path fill="#ffffff" d="M 1541 129 C 1751.5 129 1751.5 138 1962 138 L 1962 138 L 1962 0 L 1541 0 Z" stroke-width="0"></path>
    </svg>
</section>

<!-- Events Section -->
<section class="events-section section-padding" id="section_2">
    <div class="container" id="@widgetUid">
        <div class="row">

            <div class="col-lg-12 col-12 mb-4">
                <h2 class="mb-lg-5 mb-4">@Model.Properties.SectionTitle</h2>
            </div>

            <div class="row w-100 m-0 p-0 listing-items-wrap">
                @for (int i = 0; i < eventList.Count; i++)
                {
                    var ev = eventList[i];
                    var pageIndex = (i / pageSize) + 1;
                    <div class="col-lg-6 col-12 mb-5 listing-event-card" data-page="@pageIndex" style="@(pageIndex > 1 ? "display:none;" : "")">
                        <div class="custom-block-image-wrap">
                            <a href="@ev.Url">
                                <img src="@ev.ImageUrl" class="custom-block-image img-fluid" alt="@ev.Title">
                                <i class="custom-block-icon bi-link"></i>
                            </a>

                            <div class="custom-block-date-wrap">
                                <strong class="text-white">@ev.Day @ev.MonthYear</strong>
                            </div>

                            <div class="custom-btn-wrap">
                                <a href="@ev.Url" class="btn custom-btn">Buy Ticket</a>
                            </div>
                        </div>

                        <div class="custom-block-info">
                            <a href="@ev.Url" class="events-title mb-2">@ev.Title</a>
                            <p class="mb-0">@ev.Description</p>

                            <div class="border-top mt-4 pt-3">
                                <div class="d-flex flex-wrap align-items-center mb-1">
                                    <span class="custom-block-span">Location:</span>
                                    <p class="mb-0">@ev.Location</p>
                                </div>

                                <div class="d-flex flex-wrap align-items-center">
                                    <span class="custom-block-span">Ticket:</span>
                                    <p class="mb-0">@ev.TicketPrice</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.Properties.EnablePagination && eventList.Any())
            {
                var totalPages = (int)Math.Ceiling((double)eventList.Count / pageSize);
                if (totalPages <= 1) totalPages = 2;
                <div class="col-12 mt-4 d-flex justify-content-center">
                    <ul class="pagination listing-pagination" data-target="@widgetUid" data-total-pages="@totalPages">
                        <li class="page-item disabled prev-btn">
                            <a class="page-link" href="javascript:void(0);">Prev</a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == 1 ? "active" : "") page-num" data-page="@p">
                                <a class="page-link" href="javascript:void(0);">@p</a>
                            </li>
                        }
                        <li class="page-item next-btn @(totalPages <= 1 ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);">Next</a>
                        </li>
                    </ul>
                </div>

                <script>
                    (function () {
                        var widgetId = '@widgetUid';
                        var container = document.getElementById(widgetId);
                        if (!container) return;

                        var pagination = container.querySelector('.listing-pagination');
                        if (!pagination) return;

                        var totalPages = parseInt(pagination.getAttribute('data-total-pages'), 10) || 1;
                        var currentPage = 1;

                        function showPage(page) {
                            if (page < 1 || page > totalPages) return;
                            currentPage = page;

                            var items = container.querySelectorAll('.listing-event-card');
                            var found = false;
                            items.forEach(function (el) {
                                var p = parseInt(el.getAttribute('data-page'), 10);
                                if (p === page) {
                                    el.style.display = '';
                                    found = true;
                                } else {
                                    el.style.display = 'none';
                                }
                            });

                            if (!found && items.length > 0) {
                                items.forEach(function (el, idx) {
                                    el.style.display = idx < 2 ? '' : 'none';
                                });
                            }

                            pagination.querySelectorAll('.page-num').forEach(function (btn) {
                                var p = parseInt(btn.getAttribute('data-page'), 10);
                                if (p === page) btn.classList.add('active');
                                else btn.classList.remove('active');
                            });

                            var prevBtn = pagination.querySelector('.prev-btn');
                            var nextBtn = pagination.querySelector('.next-btn');
                            if (prevBtn) {
                                if (currentPage === 1) prevBtn.classList.add('disabled');
                                else prevBtn.classList.remove('disabled');
                            }
                            if (nextBtn) {
                                if (currentPage === totalPages) nextBtn.classList.add('disabled');
                                else nextBtn.classList.remove('disabled');
                            }
                        }

                        pagination.addEventListener('click', function (e) {
                            var target = e.target.closest('li.page-item');
                            if (!target || target.classList.contains('disabled')) return;

                            if (target.classList.contains('prev-btn')) {
                                showPage(currentPage - 1);
                            } else if (target.classList.contains('next-btn')) {
                                showPage(currentPage + 1);
                            } else if (target.hasAttribute('data-page')) {
                                var page = parseInt(target.getAttribute('data-page'), 10);
                                showPage(page);
                            }
                        });
                    })();
                </script>
            }

        </div>
    </div>
</section>
