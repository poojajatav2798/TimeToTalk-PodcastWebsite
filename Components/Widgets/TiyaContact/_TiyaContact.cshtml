@model Podcast.Web.Components.Widgets.TiyaContact.TiyaContactViewModel

<section class="contact-section section-padding" id="section_5">
    <div class="container">
        <div class="row">

            <div class="col-lg-5 col-12">
                <form action="#" method="post" class="custom-form contact-form" role="form" onsubmit="event.preventDefault(); alert('Message sent successfully! Our club team will reply soon.'); this.reset();">
                    <h2 class="mb-4 pb-2">@Model.Properties.Heading</h2>

                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-12 mb-3">
                            <div class="form-floating">
                                <input type="text" name="full-name" id="contact-full-name" class="form-control" placeholder="Full Name" required>
                                <label for="contact-full-name">Full Name</label>
                            </div>
                        </div>

                        <div class="col-lg-6 col-md-6 col-12 mb-3"> 
                            <div class="form-floating">
                                <input type="email" name="email" id="contact-email" pattern="[^ @@]*@@[^ @@]*" class="form-control" placeholder="Email address" required>
                                <label for="contact-email">Email address</label>
                            </div>
                        </div>

                        <div class="col-lg-12 col-12 mb-4">
                            <div class="form-floating">
                                <textarea class="form-control" id="contact-message" name="message" placeholder="Describe message here" style="height: 120px;" required></textarea>
                                <label for="contact-message">Message</label>
                            </div>

                            <button type="submit" class="form-control btn custom-btn">Submit Form</button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="col-lg-6 col-12">
                <div class="contact-info mt-5">
                    <div class="contact-info-item">
                        <div class="contact-info-body">
                            <strong>@Model.Properties.LocationName</strong>

                            <p class="mt-2 mb-1">
                                <a href="tel:@Model.Properties.PhoneNumber" class="contact-link">
                                    @Model.Properties.PhoneDisplay
                                </a>
                            </p>

                            <p class="mb-0">
                                <a href="mailto:@Model.Properties.Email" class="contact-link">
                                    @Model.Properties.Email
                                </a>
                            </p>
                        </div>

                        <div class="contact-info-footer">
                            <a href="@Model.Properties.DirectionsUrl" target="_blank" rel="noopener">Directions</a>
                        </div>
                    </div>

                    <img src="/images/WorldMap.svg" class="img-fluid" alt="World Map">
                </div>
            </div>

        </div>
    </div>
</section>
